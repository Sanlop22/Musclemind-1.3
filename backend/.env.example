# Copia este archivo como ".env" y completa los valores (el .env NO se sube a git)

# Servidor
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=tu_usuario
DB_PASSWORD=tu_contraseña
DB_NAME=musclemind
DB_CONNECTION_LIMIT=10

# Autenticación JWT
# Usa una cadena larga y aleatoria. Puedes generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_secreta
JWT_EXPIRES_IN=8h

# (Opcional) URL del frontend permitida por CORS. Si no se define, se permite cualquiera.
# CORS_ORIGIN=http://localhost:5173
